<?xml version="1.0" encoding="utf-8"?>
<!-- Mapa de pantallas. Los ids (nav_home, nav_query...) coinciden con los de los menús. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="mx.ipn.proyectofinal.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_add_event"
        android:name="mx.ipn.proyectofinal.ui.add.AddEventFragment"
        android:label="@string/title_add_event"
        tools:layout="@layout/fragment_add_event" />

    <fragment
        android:id="@+id/nav_query"
        android:name="mx.ipn.proyectofinal.ui.query.QueryFragment"
        android:label="@string/title_query"
        tools:layout="@layout/fragment_query" />

    <fragment
        android:id="@+id/nav_calendar"
        android:name="mx.ipn.proyectofinal.ui.calendar.CalendarFragment"
        android:label="@string/title_calendar"
        tools:layout="@layout/fragment_calendar" />

    <fragment
        android:id="@+id/nav_backup"
        android:name="mx.ipn.proyectofinal.ui.backup.BackupFragment"
        android:label="@string/title_backup"
        tools:layout="@layout/fragment_backup" />

    <fragment
        android:id="@+id/nav_restore"
        android:name="mx.ipn.proyectofinal.ui.backup.RestoreFragment"
        android:label="@string/title_restore"
        tools:layout="@layout/fragment_restore" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="mx.ipn.proyectofinal.ui.settings.SettingsFragment"
        android:label="@string/title_settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/nav_about"
        android:name="mx.ipn.proyectofinal.ui.about.AboutFragment"
        android:label="@string/title_about"
        tools:layout="@layout/fragment_about" />
</navigation>
